# ==============================================================================
# KhataGST Environment Configuration Template (.env.example)
# Copy this file to .env and configure values before starting the application.
# ZERO SECRETS RULE: Never commit real API keys or production secrets to Git.
# ==============================================================================

# Application Environment ("development", "production", "test")
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Configuration
# Local SQLite default: sqlite:///./khatagst.db
# External Managed Postgres (Neon / Supabase Free Tier):
# DATABASE_URL=postgresql+psycopg2://[user]:[password]@[host]:5432/[database]?sslmode=require
DATABASE_URL=sqlite:///./khatagst.db

# Security & Authentication
# In production, generate a secure random 32+ character string (e.g. `openssl rand -hex 32`)
JWT_SECRET=change_this_to_a_secure_random_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origin
# In production, set to your frontend URL (e.g. https://khatagst.onrender.com or https://khatagst.pages.dev)
# No wildcards allowed in production.
ALLOWED_ORIGIN=http://localhost:5173,http://localhost:3000

# Extraction Provider
# Use "mock" for 100% offline demo mode with sample fixtures
# Use "gemini" for live multimodal OCR via Google Gemini API
# Use "groq" for high-speed free multimodal OCR via Groq Llama 3.2 Vision (console.groq.com)
EXTRACTION_PROVIDER=mock
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Storage Mode ("temp" or "s3" / "supabase")
# "temp": In-memory / temporary storage with deletion after export (default for free tier demo).
# "s3": S3-compatible / Supabase Storage via cloud credentials. Never rely on persistent disk.
STORAGE_MODE=temp
MAX_UPLOAD_SIZE_BYTES=8388608

# Optional Cloud Storage (Required ONLY if STORAGE_MODE=s3 or supabase)
# S3_BUCKET=khatagst-invoices
# S3_REGION=us-east-1
# S3_ENDPOINT_URL=https://<project-ref>.supabase.co/storage/v1/s3
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key

# Docker Compose Local Postgres Settings
POSTGRES_USER=khatagst
POSTGRES_PASSWORD=khatagst_dev_password
POSTGRES_DB=khatagst
